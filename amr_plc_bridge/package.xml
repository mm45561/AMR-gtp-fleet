<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_plc_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridge between the fleet manager and the GTP station PLC over Modbus TCP: writes the
    station's state into the PLC and turns its DISPATCH requests into /fleet/dispatch_amr calls.
  </description>
  <maintainer email="61me38@gmail.com">Mohamed abdo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>python3-pymodbus</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
